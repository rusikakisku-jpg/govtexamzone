              </div>
            </li>
          <% }) %>
        <% } else { %>
          <li>No admission forms available yet.</li>
        <% } %>
      </ul>
      <div class="sarkari-box-footer">
        <a href="/category/admission">View More Admission →</a>
      </div>
    </div>

    <!-- Box 8: Important -->
    <div class="sarkari-box">
      <div class="sarkari-box-header">
        <a href="/category/important">Important</a>
      </div>
      <ul class="sarkari-box-list">
        <% if (importants && importants.length > 0) { %>
          <% importants.forEach(post => { %>
            <li>
              <span class="list-chevron">›</span>
              <div>
                <a href="/post/<%= post.slug %>"><%= post.title %></a>
              </div>
            </li>
          <% }) %>
        <% } else { %>
          <li>No updates listed.</li>
        <% } %>
      </ul>
      <div class="sarkari-box-footer">
        <a href="/category/important">View More Important →</a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
