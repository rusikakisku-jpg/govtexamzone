<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#ab183d">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" href="<%= (typeof settings !== 'undefined' && settings.site_favicon) ? settings.site_favicon : '/images/gez-logo.svg' %>">
  <style>
    /* ==========================================================================
       Best Modern SaaS UI - Govt Exam Zone Admin Login
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background-color: #0b1120;
    }

    /* Ambient Glow & Mesh Background */
    body.login-page-body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px 16px;
      position: relative;
      overflow-x: hidden;
      background: 
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(171, 24, 61, 0.18), transparent),
        radial-gradient(circle 600px at 80% 80%, rgba(2, 132, 199, 0.08), transparent),
        radial-gradient(circle 500px at 20% 90%, rgba(171, 24, 61, 0.06), transparent),
        #0b1120;
    }

    /* Subtle Architectural Grid Pattern Overlay */
    body.login-page-body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
      z-index: 1;
    }

    .login-container-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 450px;
      margin: auto;
    }

    /* Glassmorphism SaaS Login Card */
    .login-box {
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      box-shadow: 
        0 0 0 1px rgba(255, 255, 255, 0.05),
        0 25px 50px -12px rgba(0, 0, 0, 0.65),
        0 0 40px rgba(171, 24, 61, 0.15);
      padding: 38px 32px;
      width: 100%;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    /* Logo & Header Elements */
    .login-header-logo-wrap {
      text-align: center;
      margin-bottom: 16px;
    }

    .login-header-logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 76px;
      height: 76px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 10px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      text-decoration: none;
    }

    .login-header-logo:hover {
      transform: translateY(-2px) scale(1.04);
      border-color: rgba(171, 24, 61, 0.5);
      box-shadow: 0 12px 28px rgba(171, 24, 61, 0.25);
    }

    .login-header-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .login-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: rgba(171, 24, 61, 0.15);
      color: #ff8da6;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 9999px;
      border: 1px solid rgba(171, 24, 61, 0.35);
      margin-top: 14px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }

    .login-badge-dot {
      width: 6px;
      height: 6px;
      background: #ff4d73;
      border-radius: 50%;
      box-shadow: 0 0 8px #ff4d73;
      animation: pulseDot 1.8s infinite ease-in-out;
    }

    @keyframes pulseDot {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.75); }
      100% { opacity: 1; transform: scale(1); }
    }

    .login-title {
      font-size: 24px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.4px;
      text-align: center;
      margin: 12px 0 6px 0;
      line-height: 1.25;
    }

    .login-subtitle {
      font-size: 13px;
      color: #94a3b8;
      margin: 0 0 24px 0;
      text-align: center;
      line-height: 1.5;
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 18px;
      text-align: left;
    }

    .form-group label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 7px;
      color: #cbd5e1;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 16px;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s ease;
    }

    .form-control {
      width: 100%;
      padding: 12px 14px 12px 42px;
      font-size: 15px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      outline: none;
      font-family: inherit;
      color: #ffffff;
      background: rgba(15, 23, 42, 0.65);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      -webkit-appearance: none;
    }

    .form-control::placeholder {
      color: #475569;
    }

    .form-control:focus {
      border-color: #ab183d;
      background: rgba(15, 23, 42, 0.95);
      box-shadow: 0 0 0 3px rgba(171, 24, 61, 0.25), 0 0 16px rgba(171, 24, 61, 0.2);
    }

    .form-control:focus + .input-icon,
    .input-wrapper:focus-within .input-icon {
      color: #ff4d73;
    }

    .pwd-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .pwd-wrapper input {
      padding-right: 48px !important;
    }

    .pwd-toggle-btn {
      position: absolute;
      right: 6px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      cursor: pointer;
      font-size: 17px;
      color: #94a3b8;
      padding: 8px 10px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      min-width: 40px;
      min-height: 40px;
      touch-action: manipulation;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .pwd-toggle-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff;
    }

    /* Primary Login Button */
    .btn-submit-login {
      width: 100%;
      background: linear-gradient(135deg, #ab183d 0%, #7f0d28 100%);
      color: #ffffff;
      border: none;
      padding: 13px 18px;
      font-size: 15px;
      font-weight: 700;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 14px rgba(171, 24, 61, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
      margin-top: 8px;
      touch-action: manipulation;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      letter-spacing: -0.2px;
    }

    .btn-submit-login:hover {
      background: linear-gradient(135deg, #c21c47 0%, #8e102f 100%);
      box-shadow: 0 8px 22px rgba(171, 24, 61, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
      transform: translateY(-1.5px);
    }

    .btn-submit-login:active {
      transform: translateY(0);
      box-shadow: 0 2px 8px rgba(171, 24, 61, 0.4);
    }

    /* 1-Click Auto-Fill Button */
    .autofill-btn {
      width: 100%;
      background: rgba(2, 132, 199, 0.12);
      color: #38bdf8;
      border: 1px solid rgba(2, 132, 199, 0.35);
      padding: 11px 16px;
      font-size: 13.5px;
      font-weight: 700;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 10px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      touch-action: manipulation;
      min-height: 44px;
    }

    .autofill-btn:hover {
      background: rgba(2, 132, 199, 0.22);
      border-color: rgba(2, 132, 199, 0.6);
      color: #7dd3fc;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.2);
    }

    .autofill-btn:active {
      transform: translateY(0);
    }

    /* Error Alert */
    .alert-danger {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13px;
      line-height: 1.5;
      margin-bottom: 18px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    /* Developer Helper Quick Credentials Card */
    .login-helper-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px 16px;
      margin-top: 22px;
      font-size: 12.5px;
      color: #94a3b8;
      text-align: left;
    }

    .login-helper-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 700;
      color: #e2e8f0;
      font-size: 12px;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .credential-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: 7px;
      background: rgba(255, 255, 255, 0.03);
      padding: 7px 10px;
      border: 1px dashed rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      transition: border-color 0.15s ease, background 0.15s ease;
    }

    .credential-row:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .credential-label-val {
      display: flex;
      align-items: center;
      gap: 8px;
      word-break: break-all;
      flex: 1;
      min-width: 0;
    }

    .credential-badge {
      font-size: 10.5px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .credential-row code {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      color: #ff8da6;
      font-size: 12.5px;
      background: rgba(171, 24, 61, 0.2);
      padding: 2px 7px;
      border-radius: 5px;
      border: 1px solid rgba(171, 24, 61, 0.3);
      word-break: break-all;
    }

    .copy-mini-btn {
      background: rgba(255, 255, 255, 0.08);
      color: #cbd5e1;
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 11px;
      cursor: pointer;
      font-weight: 700;
      transition: all 0.15s ease;
      flex-shrink: 0;
      touch-action: manipulation;
      min-height: 28px;
    }

    .copy-mini-btn:hover {
      background: rgba(255, 255, 255, 0.16);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.25);
    }

    .copy-mini-btn.copied {
      background: #10b981 !important;
      color: #ffffff !important;
      border-color: #10b981 !important;
    }

    /* Footer Links & Trust Badge */
    .login-footer-links {
      text-align: center;
      margin-top: 20px;
    }

    .login-footer-links a {
      font-size: 13px;
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.15s ease;
      padding: 6px 12px;
      border-radius: 8px;
    }

    .login-footer-links a:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.06);
    }

    .security-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 11px;
      color: #64748b;
      margin-top: 14px;
      text-align: center;
    }

    .security-badge svg {
      width: 12px;
      height: 12px;
      fill: currentColor;
    }

    /* ==========================================================================
       Responsive Breakpoints: Mobile, Tablet & Desktop
       ========================================================================== */
    @media screen and (max-width: 480px) {
      body.login-page-body {
        padding: 12px 10px;
      }

      .login-box {
        padding: 26px 18px;
        border-radius: 16px;
      }

      .login-header-logo {
        width: 66px;
        height: 66px;
        border-radius: 16px;
      }

      .login-title {
        font-size: 21px;
      }

      .login-subtitle {
        font-size: 12.5px;
        margin-bottom: 20px;
      }

      /* 16px font prevents auto-zoom on iOS Safari */
      .form-control {
        font-size: 16px;
        padding: 11px 12px 11px 40px;
      }

      .btn-submit-login {
        padding: 13px 14px;
        font-size: 15px;
      }

      .autofill-btn {
        padding: 11px 14px;
        font-size: 13.5px;
      }

      .credential-row {
        padding: 6px 8px;
      }

      .credential-row code {
        font-size: 11.5px;
      }
    }

    @media screen and (max-width: 360px) {
      .login-box {
        padding: 20px 14px;
        border-radius: 14px;
      }

      .login-title {
        font-size: 19px;
      }

      .credential-row {
        flex-direction: column;
        align-items: stretch;
        gap: 6px;
      }

      .credential-label-val {
        width: 100%;
        justify-content: space-between;
      }

      .copy-mini-btn {
        width: 100%;
        text-align: center;
        padding: 6px;
        min-height: 32px;
      }
    }

    @media screen and (min-width: 768px) {
      .login-box {
        padding: 42px 36px;
      }
    }
  </style>
</head>
<body class="login-page-body">

<div class="login-container-wrapper">
  <div class="login-box">
    <!-- Brand Logo & Pill -->
    <div class="login-header-logo-wrap">
      <a href="/" class="login-header-logo" title="Back to <%= (typeof settings !== 'undefined' && settings.site_title) ? settings.site_title : 'Govt Exam Zone' %> Homepage">
        <img src="<%= (typeof settings !== 'undefined' && settings.site_logo) ? settings.site_logo : '/images/gez-logo.svg' %>" alt="<%= (typeof settings !== 'undefined' && settings.site_title) ? settings.site_title : 'Govt Exam Zone' %> Logo" width="76" height="76" style="object-fit: contain;">
      </a>
      <div>
        <span class="login-badge-pill">
          <span class="login-badge-dot"></span> Admin Console Pro
        </span>
      </div>
    </div>

    <!-- Title and Subtitle -->
    <h2 class="login-title">Admin Authentication</h2>
    <p class="login-subtitle">
      Secure portal to manage Govt Exam Zone notifications, Cloudflare D1 SQL database &amp; R2 storage.
    </p>

    <!-- Error Alert Banner -->
    <% if (error) { %>
      <div class="alert alert-danger" role="alert">
        <span style="font-size: 15px;">⚠️</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Authentication Form -->
    <form id="loginForm" action="/admin/login" method="POST">
      <!-- Username Field -->
      <div class="form-group">
        <label for="username">Username</label>
        <div class="input-wrapper">
          <span class="input-icon">👤</span>
          <input 
            type="text" 
            id="username" 
            name="username" 
            class="form-control" 
            placeholder="admin" 
            required 
            autofocus
            autocomplete="username" 
            autocapitalize="none" 
            autocorrect="off" 
            spellcheck="false"
          >
        </div>
      </div>

      <!-- Password Field -->
      <div class="form-group">
        <label for="password">Password</label>
        <div class="pwd-wrapper">
          <span class="input-icon">🔒</span>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            placeholder="govtexamzone@2026" 
            required
            autocomplete="current-password" 
            autocapitalize="none" 
            autocorrect="off" 
            spellcheck="false"
          >
          <button type="button" class="pwd-toggle-btn" id="togglePasswordBtn" title="Show / Hide Password" aria-label="Toggle password visibility">
            👁️
          </button>
        </div>
      </div>

      <!-- Primary Submit Button -->
      <button type="submit" class="btn-submit-login">
        <span>Login to Dashboard</span>
        <span style="font-size: 16px;">→</span>
      </button>

      <!-- 1-Click Auto-Fill & Login Button -->
      <button type="button" class="autofill-btn" id="autoFillBtn">
        <span>⚡</span>
        <span>1-Click Auto-Fill &amp; Login</span>
      </button>
    </form>

    <!-- Helper Box with Credentials -->
    <div class="login-helper-box">
      <div class="login-helper-header">
        <span>🔑 Quick Access Credentials</span>
      </div>
      
      <div class="credential-row">
        <div class="credential-label-val">
          <span class="credential-badge">User:</span>
          <code id="userCode">admin</code>
        </div>
        <button type="button" class="copy-mini-btn" onclick="copyCred('admin', this)">Copy</button>
      </div>

      <div class="credential-row">
        <div class="credential-label-val">
          <span class="credential-badge">Pass:</span>
          <code id="passCode">govtexamzone@2026</code>
        </div>
        <button type="button" class="copy-mini-btn" onclick="copyCred('govtexamzone@2026', this)">Copy</button>
      </div>

      <div style="margin-top: 10px; font-size: 11px; color: #64748b; line-height: 1.4;">
        💡 Tip: You can also use <code>govtexamzone</code> as username with <code>govtexamzone@2026</code>.
      </div>
    </div>

    <!-- Back to Public Site Link & Security -->
    <div class="login-footer-links">
      <a href="/">← Back to Govt Exam Zone Homepage</a>
    </div>

    <div class="security-badge">
      <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
      <span>SSL 256-Bit Encrypted • Cloudflare D1 &amp; R2 Protected</span>
    </div>
  </div>
</div>

<script>
  // Show / Hide Password toggle
  const pwdInput = document.getElementById('password');
  const toggleBtn = document.getElementById('togglePasswordBtn');
  if (pwdInput && toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        toggleBtn.textContent = '🔒';
      } else {
        pwdInput.type = 'password';
        toggleBtn.textContent = '👁️';
      }
    });
  }

  // 1-Click Auto-Fill & Login
  const autoFillBtn = document.getElementById('autoFillBtn');
  const loginForm = document.getElementById('loginForm');
  const usernameInput = document.getElementById('username');
  if (autoFillBtn && loginForm) {
    autoFillBtn.addEventListener('click', function() {
      if (usernameInput) usernameInput.value = 'admin';
      if (pwdInput) pwdInput.value = 'govtexamzone@2026';
      loginForm.submit();
    });
  }

  // Interactive Copy with Visual State Feedback
  function copyCred(val, btnEl) {
    const doCopy = () => {
      if (btnEl) {
        const originalText = btnEl.textContent;
        btnEl.textContent = '✓ Copied';
        btnEl.classList.add('copied');
        setTimeout(() => {
          btnEl.textContent = originalText;
          btnEl.classList.remove('copied');
        }, 1800);
      }
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(val).then(doCopy).catch(() => {
        prompt('Copy this:', val);
      });
    } else {
      prompt('Copy this:', val);
    }
  }
</script>

</body>
</html>
